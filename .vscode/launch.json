{
  // Используйте IntelliSense, чтобы узнать о возможных атрибутах.
  // Наведите указатель мыши, чтобы просмотреть описания существующих атрибутов.
  // Для получения дополнительной информации посетите: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "attach",
      "name": "Подключиться: users-service debug port",
      "cwd": "${workspaceFolder}/backend/users-service",
      "address": "localhost",
      "port": 9229,
      "restart": true,
      "sourceMaps": true,
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**",
        "**/VM*.js"
      ],
      "outFiles": [
        "${workspaceFolder}/backend/users-service/dist/**/*.js"
      ]
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Подключиться: выбрать Node процесс",
      "cwd": "${workspaceFolder}/backend",
      "processId": "${command:PickProcess}",
      "restart": true,
      "sourceMaps": true,
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**",
        "**/VM*.js"
      ]
    }
  ]
}
