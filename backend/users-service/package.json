{
  "name": "@backend/users-service",
  "version": "0.0.1",
  "description": "",
  "author": "taashev",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": "24.13.1",
    "npm": "11.8.0"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/infrastructure/main",
    "start:worker": "node dist/infrastructure/worker-main",
    "start:worker:dev": "nest start --watch --entryFile infrastructure/worker-main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "typeorm-ts-node-commonjs",
    "typeorm:ds": "npm run typeorm -- --dataSource ./src/infrastructure/database/ormconfig.ts",
    "migrate:create": "npm run typeorm -- migration:create ./src/infrastructure/database/migrations/$npm_config_name",
    "migrate:generate": "npm run typeorm:ds -- migration:generate ./src/infrastructure/database/migrations/$npm_config_name",
    "migrate:up": "npm run typeorm:ds migration:run",
    "migrate:down": "npm run typeorm:ds migration:revert",
    "users:generate": "ts-node --project tsconfig.json src/infrastructure/database/scripts/generate-users.ts",
    "avatars:generate": "ts-node --project tsconfig.json src/infrastructure/database/scripts/generate-avatars.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1043.0",
    "@aws-sdk/s3-presigned-post": "^3.1048.0",
    "@aws-sdk/s3-request-presigner": "^3.1064.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.2",
    "@nestjs/typeorm": "^11.0.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.77.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "file-type": "^21.3.4",
    "ioredis": "^5.11.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.5",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.28",
    "zod": "^4.3.6"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
