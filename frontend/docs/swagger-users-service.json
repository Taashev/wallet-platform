  "info": {
    "title": "Users Service API V1",
    "description": "API документация для users-service",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Paste access token"
      }
    },
    "schemas": {
      "ResponseUserDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "example": "8e27fcf1-7dfb-4ea5-a4f8-3db0884fa9d6"
          },
          "username": {
            "type": "string",
            "example": "user"
          },
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "about": {
            "type": "string",
            "example": "Backend engineer"
          },
          "dateOfBirth": {
            "type": "string",
            "example": "1999-12-31"
          },
          "age": {
            "type": "number",
            "example": 26
          }
        },
        "required": [
          "userId",
          "username",
          "email",
          "about",
          "dateOfBirth",
          "age"
        ]
      },
      "UsersListResponseDto": {
        "type": "object",
        "properties": {
          "users": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResponseUserDto"
            }
          },
          "total": {
            "type": "number",
            "example": 1
          }
        },
        "required": [
          "users",
          "total"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 2,
            "maxLength": 50,
            "example": "updated_user"
          },
          "email": {
            "type": "string",
            "minLength": 6,
            "maxLength": 255,
            "example": "updated@example.com"
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date",
            "example": "2000-01-01"
          },
          "about": {
            "type": "string",
            "maxLength": 1000,
            "example": "Updated bio"
          }
        }
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {
          "newPassword": {
            "type": "string",
            "minLength": 3,
            "maxLength": 255,
            "example": "NewStrongPass123"
          },
          "oldPassword": {
            "type": "string",
            "minLength": 3,
            "maxLength": 255,
            "example": "OldStrongPass123"
          }
        },
        "required": [
          "newPassword",
          "oldPassword"
        ]
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 2,
            "maxLength": 50,
            "example": "user"
          },
          "email": {
            "type": "string",
            "maxLength": 255,
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 3,
            "maxLength": 255,
            "example": "StrongPass123"
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date",
            "example": "1999-12-31"
          },
          "about": {
            "type": "string",
            "maxLength": 1000,
            "example": "Backend engineer"
          }
        },
        "required": [
          "username",
          "email",
          "password"
        ]
      },
      "AuthTokensDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "JWT access token",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.access.payload.signature"
          },
          "refreshToken": {
            "type": "string",
            "description": "JWT refresh token",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.refresh.payload.signature"
          }
        },
        "required": [
          "accessToken",
          "refreshToken"
        ]
      },
      "AuthLocalDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 2,
            "maxLength": 50,
            "example": "user"
          },
          "password": {
            "type": "string",
            "minLength": 3,
            "maxLength": 255,
            "example": "StrongPass123"
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "Refresh токен",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.refresh.payload.signature"
          }
        },
        "required": [
          "refreshToken"
        ]
      }
    }
  }
}
